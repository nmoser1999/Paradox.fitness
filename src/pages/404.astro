---
import ButtonLoad from '../components/ButtonLoad.astro';
import { coach } from '../data/site';
import Base from '../layouts/Base.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
---

<Base
  title="Page Not Found"
  description="Find your way back to Paradox Fitness personal training in Fremont and online coaching."
  noindex
  mobileCta={false}
>
  <section class="page-heading shell">
    <p class="eyebrow">404 / Let’s find your next step</p>
    <h1>
      A little
      <br />
      <em>off the path.</em>
    </h1>
    <p>
      This page could not be found. Explore training options or get in touch
      with {coach.firstName}.
    </p>
    <div class="actions">
      <a class="button" href="/">
        <ButtonLoad />
        Back to the homepage <ArrowIcon />
      </a>
      <a class="button button-secondary" href="/contact-us-1/">
        <ButtonLoad />
        Contact {coach.firstName} <ArrowIcon />
      </a>
    </div>
  </section>
</Base>
