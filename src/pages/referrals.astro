---
import { coach } from '../data/site';
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
---

<Base
  title="Referrals — Share Paradox Fitness"
  description={`Know someone interested in personal training or online coaching? Share Paradox Fitness and ask ${coach.name} about current referral program details.`}
>
  <section class="page-heading shell">
    <p class="eyebrow">Good things are worth sharing</p>
    <h1>
      Good training.
      <br />
      <em>Worth sharing.</em>
    </h1>
    <p>
      If you know someone who might enjoy training with {coach.name}, share the
      Paradox Fitness website with them. They can reach out and mention your
      name.
    </p>
    <p>
      Ask {coach.firstName} about current referral rewards, eligibility, and
      terms.
    </p>
    <div class="actions">
      <Action
        href="/contact-us-1/"
        label="Ask about referrals"
        placement="referral-page"
        service="unsure"
      />
    </div>
  </section>
</Base>
