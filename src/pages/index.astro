---
import { Picture } from 'astro:assets';
import trainerPortrait from '../../assets/unnamed.jpg';
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Faq from '../components/Faq.astro';
import ServiceCorner from '../components/ServiceCorner.astro';
import FinalCta from '../components/FinalCta.astro';
import { coach, site } from '../data/site';
const pillars = [
  {
    title: 'Build strength.',
    text: 'Practice the movements that help you get stronger, with a plan to follow.',
  },
  {
    title: 'Move with confidence.',
    text: 'Work on technique and mobility with guidance from your coach.',
  },
  {
    title: 'Keep showing up.',
    text: 'Build a training routine around your goals and everyday life.',
  },
];
---

<Base
  title="Personal Training in Fremont & Online Coaching"
  description={`Build strength, mobility, and consistency with ${coach.name} at Paradox Fitness in Fremont, CA. Explore a free in-person training week or online coaching.`}
>
  <section class="home-hero shell" aria-labelledby="hero-heading">
    <div class="hero-intro">
      <p class="eyebrow justify-center">Fremont, CA · In person &amp; online</p>
      <h1 id="hero-heading">
        Strength for the life
        <br class="desktop-break" /> <em>you want to live.</em>
      </h1>
      <p class="hero-description">
        One-to-one training in Fremont, CA. Online coaching wherever you train.
        <br class="desktop-break" /> Build strength, move well, and find your
        routine with {coach.name}.
      </p>
      <div class="actions justify-center">
        <Action placement="hero" />
        <Action
          href="/online-group-membership/"
          label="Explore online coaching"
          secondary
          placement="hero"
          service="online"
        />
      </div>
      <!-- <p class="fine-print">
        Complimentary in-person training week · Up to three sessions · Arranged
        with {coach.firstName}
      </p> -->
    </div>
    <div class="coach-panel">
      <figure class="coach-photo">
        <Picture
          src={trainerPortrait}
          formats={['avif', 'webp']}
          widths={[400, 720, 1080, 1440]}
          sizes="(max-width: 760px) calc(100vw - 40px), (min-width: 1328px) 600px, 50vw"
          width={1080}
          height={900}
          fit="cover"
          alt={`${coach.name}, personal trainer, in a training studio.`}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          {coach.name}
          <span>Personal training · Fremont &amp; online</span>
        </figcaption>
      </figure>
      <div class="coach-copy" id="coach">
        <p class="eyebrow">Meet {coach.name}</p>
        <h2>
          A coach
          <br />
          <em>in your corner.</em>
        </h2>
        <p>
          Know what to work on and how to approach it. {coach.firstName} brings
          structure to your training, with strength work, mobility, and guidance
          on your movements.
        </p>
        <p>
          Work together in Fremont for feedback as you train, or follow a
          program online with coaching through Trainerize. Start with your goals
          and a routine that works for you.
        </p>
        <a
          class="inline-link"
          href="/contact-us-1/"
          data-track="cta_click"
          data-placement="coach"
          data-service="unsure"
        >
          Talk training with {coach.firstName} <ArrowIcon />
        </a>
      </div>
    </div>
  </section>
  <section class="pillars shell" aria-label="Coaching priorities">
    {pillars.map((pillar, index) => (
      <div>
        <span class="index">0{index + 1} /</span>
        <div>
          <h2>{pillar.title}</h2>
          <p>{pillar.text}</p>
        </div>
      </div>
    ))}
  </section>
  <section
    class="section shell"
    id="training"
    aria-labelledby="training-heading"
  >
    <div class="section-intro">
      <p class="eyebrow">Choose your way to train</p>
      <h2 id="training-heading">
        Good coaching.
        <br />
        <em>Wherever you train.</em>
      </h2>
      <p>Hands-on guidance in Fremont or a program you can take with you.</p>
    </div>
    <div class="service-grid">
      <article class="service-card" id="pricing" tabindex="-1">
        <ServiceCorner kind="in-person" />
        <p class="eyebrow">01 / One to one · Fremont</p>
        <h3>In-person training</h3>
        <p>
          Train alongside {coach.firstName} for technique feedback and sessions
          shaped around your starting point.
        </p>
        <ul>
          <li>One-to-one sessions in Mission San Jose</li>
          <li>Strength training and mobility work</li>
          <li>Online programming between sessions</li>
        </ul>
        <div class="service-offer">
          <p class="offer-label">Try a free week · Up to three sessions</p>
          <p class="price">
            From {site.inPersonPrice}
            <span> / session afterward</span>
          </p>
          <p class="fine-print">
            Two sessions per week minimum after the trial.
          </p>
        </div>
        <Action
          href="/in-person/"
          label="See in-person training"
          placement="service-card"
        />
      </article>
      <article class="service-card service-card-light">
        <ServiceCorner kind="online" />
        <p class="eyebrow">02 / Online · Trainerize</p>
        <h3>Online coaching</h3>
        <p>
          Follow structured programs where you already train, with exercise
          tutorials, coaching, and a shared training community.
        </p>
        <ul>
          <li>Programs and on-demand workouts</li>
          <li>Exercise demonstrations and tutorials</li>
          <li>Coaching through the Trainerize app</li>
        </ul>
        <div class="service-offer">
          <p class="offer-label">Start with a seven-day trial</p>
          <p class="price">
            {site.onlinePrice}
            <span> / month afterward</span>
          </p>
          <p class="fine-print">
            Review subscription terms at Trainerize checkout.
          </p>
        </div>
        <Action
          href="/online-group-membership/"
          label="Explore online coaching"
          secondary
          placement="service-card"
          service="online"
        />
      </article>
    </div>
  </section>
  <section class="section steps-section shell" aria-labelledby="steps-heading">
    <div class="section-intro">
      <p class="eyebrow">Getting started in person</p>
      <h2 id="steps-heading">
        A conversation.
        <br />
        <em>Then a plan.</em>
      </h2>
    </div>
    <ol class="steps">
      <li>
        <span>01</span>
        <h3>Share your goals.</h3>
        <p>
          Send {coach.firstName} a short inquiry. Tell him what you want to work
          on, or ask for help choosing where to start.
        </p>
      </li>
      <li>
        <span>02</span>
        <h3>Find your starting point.</h3>
        <p>
          Talk through your experience, your routine, and the support you are
          looking for.
        </p>
      </li>
      <li>
        <span>03</span>
        <h3>Arrange your free week.</h3>
        <p>
          Confirm your training times with {coach.firstName}. Try up to three
          sessions before discussing an ongoing plan.
        </p>
      </li>
    </ol>
  </section>
  <Faq />
  <FinalCta />
</Base>
