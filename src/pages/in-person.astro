---
import Base from '../layouts/Base.astro';
import DirectionsLink from '../components/DirectionsLink.astro';
import Action from '../components/Action.astro';
import FinalCta from '../components/FinalCta.astro';
import Faq from '../components/Faq.astro';
import { coach, site, faqs } from '../data/site';
---

<Base
  title="One-to-One Personal Training in Fremont"
  description={`Train one to one with ${coach.name} in Fremont’s Mission San Jose neighborhood. Build strength and mobility with personal guidance. Ask about a free training week.`}
>
  <div class="shell">
    <section class="page-heading">
      <p class="eyebrow">One to one / Fremont, California</p>
      <h1>
        Get stronger.
        <br />
        <em>With a coach beside you.</em>
      </h1>
      <p>
        One-to-one training with {coach.name} in Fremont’s Mission San Jose
        neighborhood. Work on strength, mobility, and technique with feedback as
        you train.
      </p>
      <div class="actions">
        <Action placement="in-person-hero" />
      </div>
      <p class="fine-print">
        Free in-person week · Up to three sessions · Arranged with{' '}
        {coach.firstName}
      </p>
    </section>
    <section class="content-grid section" aria-labelledby="in-person-heading">
      <div class="content-block">
        <h2 id="in-person-heading">
          Know what to do.
          <br />
          <em>Learn how to do it well.</em>
        </h2>
        <p>
          Training is easier to approach when you have a plan and someone to
          guide you through it. Work directly with {coach.firstName} on your
          movements, with feedback during each session.
        </p>
        <ul>
          <li>One-to-one coaching and technique feedback</li>
          <li>Training shaped around your starting point</li>
          <li>Online programming to support consistency between sessions</li>
        </ul>
        <p>
          New to training or returning to a routine? Start with a conversation
          about your goals and experience. {coach.firstName} will help you find
          a starting point for your complimentary week.
        </p>
      </div>
      <aside class="content-panel" id="pricing" tabindex="-1">
        <p class="eyebrow">Your training plan</p>
        <h2>Start with a free week.</h2>
        <p>
          Try up to three in-person sessions, with times arranged with{' '}
          {coach.firstName}.
        </p>
        <p class="price">
          From {site.inPersonPrice}
          <span> / session</span>
        </p>
        <p>
          A minimum of two sessions per week after the complimentary trial.
          Billing is through Square every two weeks.
        </p>
        <p>No large package purchase is required to get started.</p>
        <hr />
        <h3>Where we train</h3>
        <address>
          {site.address}
          <br />
          {site.city}
        </address>
        <p class="fine-print">Parking is shared with Intero.</p>
        <DirectionsLink label="Find the studio" />
      </aside>
    </section>
  </div>
  <Faq items={faqs.filter((_, index) => index !== 4)} />
  <FinalCta />
</Base>
