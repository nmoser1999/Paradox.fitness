---
import Base from '../layouts/Base.astro';
import DirectionsLink from '../components/DirectionsLink.astro';
import Action from '../components/Action.astro';
import FinalCta from '../components/FinalCta.astro';
import Faq from '../components/Faq.astro';
import { coach, site } from '../data/site';
---

<Base
  title="One-to-One Personal Training in Fremont"
  description={`Train one to one with ${coach.name} in Fremont’s Mission San Jose neighborhood. Build strength and mobility with personal guidance. Ask about a free training week.`}
>
  <div class="shell">
    <section class="page-heading">
      <p class="eyebrow">One to one / Fremont, California</p>
      <h1>
        Build a stronger
        <br />
        <em>everyday.</em>
      </h1>
      <p>
        Personal guidance, useful feedback, and a plan for getting stronger.
        Train with {coach.name} at the Mission San Jose location.
      </p>
      <div class="actions">
        <Action placement="in-person-hero" />
      </div>
      <p class="fine-print">
        Complimentary week · Maximum three sessions · Arranged with{' '}
        {coach.firstName}
      </p>
    </section>
    <section class="content-grid section" aria-labelledby="in-person-heading">
      <div class="content-block">
        <h2 id="in-person-heading">
          Coaching that is
          <br />
          there with you.
        </h2>
        <p>
          Get feedback as you train and work on movements with someone in your
          corner. Sessions bring structure to strength work, mobility, and the
          practice of moving well.
        </p>
        <ul>
          <li>One-to-one coaching and technique feedback</li>
          <li>Training shaped around your starting point</li>
          <li>Online programming to support consistency between sessions</li>
        </ul>
        <p>
          Start with an inquiry. {coach.firstName} will talk through your goals,
          explain the approach, and help arrange your next step.
        </p>
      </div>
      <aside class="content-panel">
        <h2>Clear expectations.</h2>
        <p class="price">
          From {site.inPersonPrice}
          <span> / session</span>
        </p>
        <p>
          A minimum of two sessions per week after the complimentary trial.
          Billing is through Square every two weeks.
        </p>
        <p>No large package purchase is required to get started.</p>
        <address>
          {site.address}
          <br />
          {site.city}
        </address>
        <DirectionsLink class="inline-link" label="Find the studio" />
      </aside>
    </section>
  </div>
  <Faq />
  <FinalCta />
</Base>
