---
import { Picture } from 'astro:assets';
import trainerPortrait from '../../assets/unnamed.jpg';
import Base from '../layouts/Base.astro';
import DirectionsLink from '../components/DirectionsLink.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { coach, site } from '../data/site';
---

<Base
  title={`Start Training — Contact ${coach.name}`}
  description={`Ask ${coach.name} about personal training in Fremont, a complimentary training week, or Paradox online coaching. Send a short inquiry to get started.`}
  mobileCta={false}
>
  <div class="shell">
    <section class="page-heading" data-network-open>
      <p class="eyebrow">Get in touch with {coach.name}</p>
      <h1>
        Let’s talk
        <br />
        <em>about your training.</em>
      </h1>
      <p>
        Have a goal in mind, a question about coaching, or no idea where to
        start? Send {coach.firstName} a note. He’ll follow up to talk through
        your options and arrange the next step.
      </p>
    </section>
    <div class="contact-grid">
      <InquiryForm />
      <aside class="content-panel">
        <h2>Talk to {coach.firstName} directly.</h2>
        <div class="contact-headshot">
          <Picture
            src={trainerPortrait}
            formats={['avif', 'webp']}
            widths={[480, 640, 960]}
            sizes="448px"
            width={640}
            height={640}
            fit="cover"
            alt={`${coach.name}, your personal trainer.`}
            loading="lazy"
            decoding="async"
          />
        </div>
        <p>
          <a
            href={`mailto:${site.email}`}
            data-track="contact_click"
            data-placement="contact-page"
            data-channel="email"
          >
            {site.email}
          </a>
          <br />
          <a
            href={site.phoneHref}
            data-track="contact_click"
            data-placement="contact-page"
            data-channel="phone"
          >
            {site.phone}
          </a>
        </p>
        <hr />
        <h3>Training in Fremont</h3>
        <address>
          {site.address}
          <br />
          {site.city}
        </address>
        <p>
          Mission San Jose location.
          <br />
          Parking shared with Intero.
        </p>
        <DirectionsLink />
        <p>
          <span class="footer-hours-label">
            Training hours · By appointment only
          </span>
          {site.hours.map((hours) => (
            <span class="block">{hours}</span>
          ))}
        </p>
        <p class="fine-print">
          Complimentary in-person training week: up to three sessions, with
          times and details arranged with {coach.firstName}.
        </p>
      </aside>
    </div>
  </div>
</Base>

<style>
  .contact-headshot {
    position: relative;
    width: 160px;
    max-width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    border: 1px solid var(--line);
    margin-bottom: 24px;
    background: var(--paper);
  }
  /* Reframe the existing square portrait around Nicho's head and shoulders. */
  .contact-headshot :global(img) {
    position: absolute;
    left: -90%;
    top: -63%;
    width: 280%;
    height: 280%;
    max-width: none;
    object-fit: cover;
  }
</style>
