---
import { faqs } from '../data/site';
import Action from './Action.astro';
import DirectionsLink from './DirectionsLink.astro';
interface Props {
  items?: ReadonlyArray<{
    question: string;
    answer: string;
    cta?: 'inquiry' | 'online' | 'directions' | 'pricing';
  }>;
}
const { items = faqs }: Props = Astro.props;
const actions = {
  inquiry: {},
  online: {
    href: '/online-group-membership/',
    label: 'Explore online coaching',
    service: 'online',
  },
  pricing: {
    href: '#pricing',
    label: 'See Pricing',
  },
} as const;
---

<section
  class="section faq-section shell"
  id="questions"
  aria-labelledby="faq-heading"
>
  <div class="section-intro">
    <p class="eyebrow">Your questions, answered</p>
    <h2 id="faq-heading">
      Before you
      <br />
      <em>get started.</em>
    </h2>
  </div>
  <div class="faq-list">
    {items.map((faq) => (
      <details>
        <summary>
          {faq.question}
          <span aria-hidden="true">+</span>
        </summary>
        <p>{faq.answer}</p>
        {faq.cta && (
          <div class="faq-action">
            {faq.cta === 'directions' ? (
              <DirectionsLink />
            ) : (
              <Action placement="faq" {...actions[faq.cta]} />
            )}
          </div>
        )}
      </details>
    ))}
  </div>
</section>

<style>
  .faq-action {
    padding-bottom: 24px;
  }
</style>
