---
import { faqs } from '../data/site';
---

<section class="section shell" id="questions" aria-labelledby="faq-heading">
  <div class="section-intro">
    <p class="eyebrow">A few things you might be wondering</p>
    <h2 id="faq-heading">A clear place to start.</h2>
  </div>
  <div class="faq-list">
    {faqs.map((faq) => (
      <details>
        <summary>
          {faq.question}
          <span aria-hidden="true">+</span>
        </summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </div>
</section>
