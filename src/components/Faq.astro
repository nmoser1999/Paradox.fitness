---
import { faqs } from '../data/site';
interface Props {
  items?: ReadonlyArray<{ question: string; answer: string }>;
}
const { items = faqs } = Astro.props;
---

<section
  class="section faq-section shell"
  id="questions"
  aria-labelledby="faq-heading"
>
  <div class="section-intro">
    <p class="eyebrow">Your questions, answered</p>
    <h2 id="faq-heading">
      Before you
      <br />
      <em>get started.</em>
    </h2>
  </div>
  <div class="faq-list">
    {items.map((faq) => (
      <details>
        <summary>
          {faq.question}
          <span aria-hidden="true">+</span>
        </summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </div>
</section>
