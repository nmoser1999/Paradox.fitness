---
import { site } from '../data/site';

interface Props {
  label?: string;
  class?: string;
}
const { label = 'Get directions', class: className } = Astro.props;
---

<a
  class:list={['directions-link', className]}
  href={site.directions}
  target="_blank"
  rel="noopener"
>
  <span class="directions-label">{label}</span>
  <img
    class="maps-icon"
    src="/icons/google-maps.webp"
    width="64"
    height="64"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <span class="sr-only"> in Google Maps (opens in a new tab)</span>
</a>
