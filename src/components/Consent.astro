---
import ButtonLoad from './ButtonLoad.astro';
---

<section
  id="consent-panel"
  class="consent-panel"
  aria-label="Analytics preferences"
  hidden
>
  <div>
    <h2>Your analytics preferences</h2>
    <p id="consent-description">
      With your permission, we use optional analytics to understand which pages
      and links are useful. Your inquiry works either way.{' '}
      <a href="/privacy/">Privacy details</a>.
    </p>
  </div>
  <div class="consent-actions">
    <button type="button" class="button button-secondary" data-consent="denied">
      <ButtonLoad>Decline optional analytics</ButtonLoad>
    </button>
    <button type="button" class="button" data-consent="granted">
      <ButtonLoad>Allow analytics</ButtonLoad>
    </button>
  </div>
</section>
