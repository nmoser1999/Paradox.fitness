---
// The moving surface is one solid plate. Its paired label counter-translates,
// keeping text and the arrow fixed as their contrasting colors are revealed.
const content = await Astro.slots.render('default');
---

<Fragment set:html={content} />
<span class="button-load" aria-hidden="true" inert>
  <span class="button-load__fill">
    <svg
      class="button-load__plate"
      viewBox="0 0 100 100"
      width="100"
      height="100"
      fill="none"
      preserveAspectRatio="xMidYMid meet"
      focusable="false"
    >
      <circle cx="50" cy="50" r="50" fill="var(--button-fill-surface)" />
      <g stroke="currentColor" stroke-width="1.1" opacity="0.18">
        <circle cx="50" cy="50" r="47" />
        <circle cx="50" cy="50" r="41" />
        <circle cx="50" cy="50" r="9" />
        <circle cx="50" cy="50" r="5" />
        <path d="M35 20a34 34 0 0 1 30 0l-3 7a26 26 0 0 0-24 0zM20 35a34 34 0 0 0 0 30l7-3a26 26 0 0 1 0-24zM80 35a34 34 0 0 1 0 30l-7-3a26 26 0 0 0 0-24z" />
      </g>
      <text
        x="50"
        y="37"
        fill="currentColor"
        opacity="0.2"
        text-anchor="middle"
        font-family="Arial, sans-serif"
        font-size="9"
        font-weight="700"
        letter-spacing="1"
      >
        20 KG
      </text>
    </svg>
    <span class="button-load__content">
      <Fragment set:html={content} />
    </span>
  </span>
</span>
