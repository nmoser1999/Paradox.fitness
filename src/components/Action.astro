---
import ArrowIcon from './ArrowIcon.astro';
interface Props {
  href?: string;
  label?: string;
  secondary?: boolean;
  placement: string;
  event?: 'cta_click' | 'online_checkout_click' | 'contact_click';
  service?: 'in-person' | 'online' | 'unsure';
}
const {
  href = '/contact-us-1/?service=in-person',
  label = 'Request your free week',
  secondary = false,
  placement,
  event = 'cta_click',
  service = 'in-person',
} = Astro.props;
const external = href.startsWith('https://');
---

<a
  class:list={['button', { 'button-secondary': secondary }]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-track={event}
  data-placement={placement}
  data-service={service}
>
  {label}
  <ArrowIcon direction={external ? 'up-right' : 'right'} />
  {external && <span class="sr-only"> (opens in a new tab)</span>}
</a>
