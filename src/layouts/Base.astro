---
import ButtonLoad from '../components/ButtonLoad.astro';
import '../styles/global.css';
import '../styles/appearance.css';
import '../styles/color-mode.css';
import '../styles/buttons.css';
import { COLOR_MODE_KEY } from '../lib/color-mode';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import TrainingAtmosphere from '../components/TrainingAtmosphere.astro';
import { defaultDesign } from '../lib/design';
import { coach, site } from '../data/site';
import { getImage } from 'astro:assets';
import trainerPortrait from '../../assets/unnamed.jpg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  mobileCta?: boolean;
}
const { title, description, noindex = false, mobileCta = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const indexable = import.meta.env.SITE_INDEXABLE === 'true' && !noindex;
const onlinePage = Astro.url.pathname === '/online-group-membership/';
const colorModeSeed = {
  modeStorageKey: COLOR_MODE_KEY,
};
const social = await getImage({
  src: trainerPortrait,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
  quality: 75,
});
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: site.name,
  url: Astro.site?.toString(),
  telephone: '+1-510-606-0868',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressLocality: 'Fremont',
    addressRegion: 'CA',
    postalCode: '94539',
    addressCountry: 'US',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '06:00',
      closes: '19:30',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '06:00',
      closes: '12:00',
    },
  ],
  sameAs: [site.instagram],
};
---

<!doctype html>
<html
  lang="en"
  data-theme={defaultDesign.theme}
  data-layout={defaultDesign.layout}
>
  <head>
    <meta charset="utf-8" />
    <script is:inline define:vars={{ colorModeSeed }}>
      // The Studio/panorama design is fixed in HTML; only light/dark mode varies.
      (() => {
        let mode;
        try {
          mode = localStorage.getItem(colorModeSeed.modeStorageKey);
        } catch {}
        document.documentElement.dataset.mode =
          mode === 'dark' ||
          (mode !== 'light' &&
            matchMedia('(prefers-color-scheme: dark)').matches)
            ? 'dark'
            : 'light';
      })();
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | Paradox Fitness</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index,follow' : 'noindex,nofollow'}
    />
    <meta name="theme-color" content="#f7f8fb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={`${title} | Paradox Fitness`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(social.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Personal training with ${coach.name}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
  </head>
  <body class:list={{ 'has-mobile-cta': mobileCta }} data-clarity-mask="true">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <TrainingAtmosphere />
      <slot />
    </main>
    <Footer />
    <Consent />
    {mobileCta && (
      <a
        class="mobile-cta button"
        href={onlinePage ? site.checkout : '/contact-us-1/?service=in-person'}
        target={onlinePage ? '_blank' : undefined}
        rel={onlinePage ? 'noopener' : undefined}
        data-track={onlinePage ? 'online_checkout_click' : 'cta_click'}
        data-placement="mobile-sticky"
        data-service={onlinePage ? 'online' : 'in-person'}
      >
        <ButtonLoad>
          {onlinePage ? 'Start your online trial' : 'Request your free week'}{' '}
          <ArrowIcon direction={onlinePage ? 'up-right' : 'right'} />
          {onlinePage && <span class="sr-only"> (opens in a new tab)</span>}
        </ButtonLoad>
      </a>
    )}
    <script>
      import { initializeColorMode } from '../lib/color-mode';
      import '../lib/consent';
      initializeColorMode();
    </script>
  </body>
</html>
