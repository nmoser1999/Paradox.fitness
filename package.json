{
  "name": "paradox-fitness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/postbuild.mjs",
    "build:audit": "node scripts/build-audit.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "preview:audit": "npm run build:audit && astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:site": "node scripts/check-site.mjs",
    "verify": "npm run check && npm test && npm run build && npm run check:site"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
